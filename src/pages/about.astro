---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
import { tutors } from '../data/tutors';
import { withBase } from '../lib/paths';

const { currencySymbol } = business.rates;
---

<BaseLayout
  title="About | Yong's Tutoring"
  description="Yong's Tutoring is an online one to one tutoring service for GCSE and A-level maths, economics, biology and chemistry, taught by a small team of tutors from Imperial and Cambridge."
  path="/about/"
>
  <section class="section section--petrol">
    <div class="wrap">
      <span class="eyebrow">About us</span>
      <h1>About Yong's Tutoring</h1>
      <p class="lede" style="color: var(--stone);">
        Yong's Tutoring is an online one to one tutoring service for GCSE and
        A-level maths, economics, biology and chemistry. We pair students with a
        specialist tutor and focus on real understanding and exam technique, not
        just cramming.
      </p>
    </div>
  </section>

  <section class="section section--stone">
    <div class="wrap about-body">
      <div class="about-main">
        <h2>What we do</h2>
        <p>
          We teach maths, further maths, economics, biology, chemistry and physics
          at GCSE and A-level, one to one and online, across all exam boards, and
          we offer Oxbridge, Imperial and medical school interview preparation.
          Every student is matched with a tutor who knows the subject well and has
          sat these exams recently, so lessons are relevant and up to date.
        </p>

        <h2>How we teach</h2>
        <p>
          We start with quick introductions and what you are aiming for. You can
          come to lessons with a plan for what you want to cover, or we design one
          together in the first lesson. Think of tutoring like a road map: we agree
          where you are and where you want to get to, then plan the route and adjust
          it as we go.
        </p>

        <h2>How lessons work</h2>
        <p>
          Lessons run one to one over video with a shared whiteboard, so we work
          through problems together in real time and you keep the worked solutions
          afterwards. Because everything is online, we teach students anywhere in
          the world, including international students planning to apply to UK
          universities. GCSE is {currencySymbol}{business.rates.gcse} an hour,
          A-level is {currencySymbol}{business.rates.alevel} an hour and interview
          preparation is {currencySymbol}{business.rates.interview} an hour.
        </p>

        <h2>Our tutors</h2>
        <p>
          We are a small, hand picked team. Our tutors study at leading
          universities, including Imperial College London and the University of
          Cambridge, and were achieving top grades in these subjects themselves not
          long ago. You can read each tutor's background on the
          {' '}<a href={withBase('/tutors/')}>tutors page</a>.
        </p>
      </div>

      <aside class="about-side">
        <div class="schedule">
          <div class="schedule__head">
            <span>Yong's Tutoring</span>
            <span>At a glance</span>
          </div>
          <div class="schedule__row">
            <span class="schedule__label">Subjects</span>
            <span class="schedule__value">Maths, further maths, economics, biology, chemistry, physics</span>
          </div>
          <div class="schedule__row">
            <span class="schedule__label">Levels</span>
            <span class="schedule__value">GCSE, A-level, interview prep</span>
          </div>
          <div class="schedule__row">
            <span class="schedule__label">Format</span>
            <span class="schedule__value">One to one, online</span>
          </div>
          <div class="schedule__row">
            <span class="schedule__label">Reach</span>
            <span class="schedule__value">Worldwide</span>
          </div>
          <div class="schedule__row">
            <span class="schedule__label">Rates</span>
            <span class="schedule__value">From {currencySymbol}{business.rates.gcse}/hour</span>
          </div>
          <div class="schedule__row">
            <span class="schedule__label">Tutors</span>
            <span class="schedule__value">{tutors.length}, from Imperial and Cambridge</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--petrol">
    <div class="wrap">
      <h2>Book a first lesson</h2>
      <p class="lede" style="color: var(--stone);">
        Message {business.phoneDisplay} on WhatsApp or email {business.email} and
        we will match you with the right tutor. Lessons are {business.areaServedDisplay}.
      </p>
      <div class="about-actions">
        <a class="btn btn--primary" href={withBase('/contact/')}>Book a consult</a>
        <a class="btn btn--ghost" href={withBase('/tutors/')}>Meet the tutors</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-body {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 46rem) {
    .about-body {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .about-main h2 {
    margin-top: 2rem;
  }

  .about-main h2:first-child {
    margin-top: 0;
  }

  .about-main p {
    max-width: 46rem;
    color: var(--muted);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }
</style>
