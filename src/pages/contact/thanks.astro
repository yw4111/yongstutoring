---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../data/business';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="Thanks | Yong's Tutoring"
  description="Thank you for your enquiry to Yong's Tutoring. I will get back to you as soon as I can."
  path="/contact/thanks/"
>
  <section class="section section--petrol">
    <div class="wrap">
      <span class="eyebrow">Enquiry received</span>
      <h1>Thanks, I have your details</h1>
      <p class="lede" style="color: var(--stone);">
        I will get back to you as soon as I can. To reach me sooner, message
        {business.phoneDisplay} on WhatsApp.
      </p>
      <p>
        <a class="btn btn--primary" href={withBase('/')}>Back to home</a>
      </p>
    </div>
  </section>
</BaseLayout>
