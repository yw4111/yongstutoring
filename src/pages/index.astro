---
import BaseLayout from '../layouts/BaseLayout.astro';
import TutorPhoto from '../components/TutorPhoto.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { business } from '../data/business';
import { subjects } from '../data/subjects';
import { tutors } from '../data/tutors';
import { homeFaqs } from '../data/faqs';
import { faqSchema, qaPageSchema } from '../lib/schema';
import { withBase } from '../lib/paths';

const schema = [faqSchema(homeFaqs), qaPageSchema(homeFaqs)];
const { currencySymbol } = business.rates;

const tiers = [
  {
    name: 'GCSE',
    subtitle: 'Maths, economics, biology, chemistry and physics',
    price: `${currencySymbol}${business.rates.gcse}`,
    features: ['One to one, online', 'All exam boards, foundation and higher', 'Topic teaching and past papers', 'Matched to your specification'],
  },
  {
    name: 'A-level',
    subtitle: 'Maths, further maths, economics and the sciences',
    price: `${currencySymbol}${business.rates.alevel}`,
    featured: true,
    features: ['One to one, online', 'All subjects and exam boards', 'Exam technique and past papers', 'Taught by Imperial and Cambridge tutors'],
  },
  {
    name: 'Interview prep',
    subtitle: 'Oxbridge, Imperial and medical school',
    price: `${currencySymbol}${business.rates.interview}`,
    features: ['One to one, online', 'Mock interviews with feedback', 'Economics and medicine', 'From tutors who got in'],
  },
];
---

<BaseLayout
  title="Yong's Tutoring | Online GCSE and A-level maths, science and economics"
  description="Online one to one tutoring in maths, further maths, economics, biology, chemistry and physics for GCSE and A-level, plus Oxbridge and medical interview prep. Taught by tutors from Imperial and Cambridge. GCSE £40/hr, A-level £45/hr."
  path="/"
  schema={schema}
>
  <!-- HERO -->
  <section class="section hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Online tutoring &middot; GCSE &amp; A-level maths, science &amp; economics</p>
        <h1>Grades that open doors. One to one, online.</h1>
        <p class="hero-sub">
          Yong's Tutoring pairs you with a dedicated subject specialist for GCSE
          and A-level maths, science and economics, building real understanding
          and exam technique, not just cramming.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={withBase('/contact/')}>Book a free consultation</a>
          <a class="btn btn--ghost" href={withBase('/pricing/')}>View subjects &amp; pricing</a>
        </div>
      </div>
    </div>
    <div class="wrap hero-stats">
      <div><span class="hero-stats__n">{currencySymbol}{business.rates.gcse}/hr</span><span class="hero-stats__l">Lessons from</span></div>
      <div><span class="hero-stats__n">1 to 1</span><span class="hero-stats__l">Online, all exam boards</span></div>
    </div>
  </section>

  <!-- WHAT IS / DIRECT ANSWER + AT A GLANCE -->
  <section class="section section--stone" id="what">
    <div class="wrap answer-grid">
      <div class="answer-copy">
        <h2>What is Yong's Tutoring?</h2>
        <p class="answer-lead">
          Yong's Tutoring is an online, one-to-one tutoring service for GCSE and
          A-level students in maths, further maths, economics, biology, chemistry
          and physics, plus Oxbridge, Imperial and medical school interview
          preparation. Lessons are taught by specialist tutors from Imperial and
          Cambridge, from {currencySymbol}{business.rates.gcse} per hour, with a
          free consultation to match you with the right tutor.
        </p>
      </div>
      <table class="glance">
        <caption class="visually-hidden">Levels, subjects and hourly prices</caption>
        <thead>
          <tr><th scope="col">Level</th><th scope="col">Subjects</th><th scope="col">Per hour</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">GCSE</th>
            <td>Maths, Economics, Biology, Chemistry, Physics</td>
            <td class="glance__price">{currencySymbol}{business.rates.gcse}</td>
          </tr>
          <tr>
            <th scope="row">A-level</th>
            <td>Maths, Further Maths, Economics, Biology, Chemistry, Physics</td>
            <td class="glance__price">{currencySymbol}{business.rates.alevel}</td>
          </tr>
          <tr>
            <th scope="row">Interview Preparation</th>
            <td>Oxbridge &amp; Imperial economics, Medical school</td>
            <td class="glance__price">{currencySymbol}{business.rates.interview}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" style="text-align:left; margin-inline:0; max-width:38rem;">
        <p class="eyebrow">How it works</p>
        <h2>Getting started takes three steps</h2>
      </div>
      <ol class="steps">
        <li class="step">
          <span class="step__n">1</span>
          <div>
            <h3>Free consultation</h3>
            <p>Tell us the subject, level and exam board you need, and what you want to improve. There is no charge and no obligation.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__n">2</span>
          <div>
            <h3>Matched with a specialist</h3>
            <p>We pair you with a tutor from Imperial or Cambridge who studied your subject and knows your specification.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__n">3</span>
          <div>
            <h3>Weekly one-to-one lessons</h3>
            <p>Learn online over video, working through the topics holding you back and past papers, at a time that fits around school.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- MEET THE TUTORS -->
  <section class="section section--stone" id="about">
    <div class="wrap">
      <div class="section-head" style="text-align:left; margin-inline:0; max-width:38rem;">
        <p class="eyebrow">The team</p>
        <h2>Meet the tutors</h2>
        <p class="lede muted">
          One to one, online, matched to your subject and level. We are a small,
          hand picked team, so ask if you would like a particular subject or time.
        </p>
      </div>
      <div class="tutors-preview">
        {
          tutors.map((t) => (
            <a class="tprev" href={withBase(`/tutors/${t.slug}/`)}>
              <TutorPhoto photo={t.photo} name={t.name} class="tprev__photo" />
              <div>
                <span class="tprev__name">{t.name}</span>
                <span class="tprev__role">{t.role}</span>
              </div>
            </a>
          ))
        }
      </div>
      <p class="tutors-more"><a class="btn btn--ghost" href={withBase('/tutors/')}>Meet the team</a></p>
    </div>
  </section>

  <!-- CHOOSE YOUR TRACK (pricing tiers) -->
  <section class="section" id="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Subjects &amp; pricing</p>
        <h2>Choose your track</h2>
      </div>
      <div class="tiers">
        {
          tiers.map((t) => (
            <div class={`tier${t.featured ? ' tier--featured' : ''}`}>
              {t.featured && <div class="tier__badge">Most popular</div>}
              <div class="tier__name">{t.name}</div>
              <div class="tier__subtitle">{t.subtitle}</div>
              <div class="tier__price"><span class="tier__num">{t.price}</span> / hour</div>
              <ul class="tier__features">
                {t.features.map((f) => (
                  <li><span aria-hidden="true">&#10003;</span> {f}</li>
                ))}
              </ul>
              <a class="btn btn--primary tier__cta" href={withBase('/contact/')}>Get started</a>
            </div>
          ))
        }
      </div>

      <div class="subjects-row">
        {
          subjects.map((s) => (
            <a class="subject-chip" href={withBase(`/subjects/${s.slug}/`)}>
              {s.shortName} <span aria-hidden="true">&rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY / TRUST -->
  <section class="section section--stone">
    <div class="wrap">
      <div class="section-head">
        <h2>Why students learn with us</h2>
      </div>
      <div class="why-grid">
        <div class="why-item"><h3>Taught by specialists</h3><p>Learn from students at Cambridge and Imperial, teaching the subjects they excelled in themselves.</p></div>
        <div class="why-item"><h3>Recent top grades</h3><p>Top A-level grades and recent exam experience, so lessons come from people who sat these papers not long ago.</p></div>
        <div class="why-item"><h3>Built around you</h3><p>Lessons start with the topics holding you back, matched to your exam board and past papers.</p></div>
        <div class="why-item"><h3>Flexible and online</h3><p>One to one over video, so lessons fit around school wherever you are in the world.</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--stone">
    <div class="wrap faq-wrap">
      <div class="section-head"><h2>Questions</h2></div>
      <FaqBlock faqs={homeFaqs} heading="" level="h3" />
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section--petrol" id="contact">
    <div class="wrap cta">
      <h2>Book a free consultation</h2>
      <p>Tell us what you want to work on and your exam board, and we will match you with the right tutor and plan a first lesson around it.</p>
      <div class="cta__actions">
        <a class="btn btn--primary" href={business.whatsappHref}>WhatsApp {business.phoneDisplay}</a>
        <a class="btn btn--ghost" href={`mailto:${business.email}`}>Email us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: clamp(2.5rem, 6vw, 4.5rem); }

  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-grid > div { max-width: 44rem; }

  .hero-sub {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--muted);
    max-width: 34rem;
    margin: 1.25rem 0 2rem;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--hairline);
    text-align: center;
  }

  .hero-stats__n {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    color: var(--ink);
  }

  .hero-stats__l { font-size: 0.85rem; color: var(--muted); }

  /* What is / direct answer + at a glance table */
  .answer-grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .answer-grid { grid-template-columns: 1.1fr 1fr; }
  }

  .answer-lead {
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    color: var(--ink);
    max-width: 38rem;
    margin-top: 0.75rem;
  }

  .glance {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    font-size: 0.95rem;
  }

  .glance caption { text-align: left; }

  .glance th,
  .glance td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }

  .glance thead th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--petrol);
    background: var(--stone-bg);
  }

  .glance tbody th {
    font-family: var(--font-display);
    font-weight: 600;
    white-space: nowrap;
  }

  .glance tbody tr:last-child th,
  .glance tbody tr:last-child td { border-bottom: 0; }

  .glance__price {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--petrol);
    white-space: nowrap;
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* How it works steps */
  .steps {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: var(--gap);
    counter-reset: step;
  }

  @media (min-width: 46rem) {
    .steps { grid-template-columns: repeat(3, 1fr); }
  }

  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1.4rem;
  }

  .step__n {
    flex-shrink: 0;
    width: 2.1rem; height: 2.1rem;
    display: grid; place-content: center;
    border-radius: 50%;
    background: var(--petrol);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .step h3 { margin: 0.2rem 0 0.35rem; font-size: 1.12rem; }
  .step p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  /* Meet the tutors */
  .meet-grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 46rem) {
    .meet-grid { grid-template-columns: 0.8fr 1.2fr; }
  }

  .meet-bio { color: var(--muted); max-width: 38rem; }

  .tutors-preview {
    display: grid;
    gap: var(--gap);
    margin-top: 1.5rem;
  }

  @media (min-width: 34rem) {
    .tutors-preview { grid-template-columns: repeat(2, 1fr); }
  }

  .tprev {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1rem;
    text-decoration: none;
    color: var(--ink);
  }

  .tprev:hover { border-color: var(--petrol); }
  .tprev__photo { width: 56px; flex-shrink: 0; }
  .tprev__name { display: block; font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; }
  .tprev__role { display: block; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--petrol); }

  .tutors-more { margin-top: 1.5rem; }

  /* Tiers */
  .tiers {
    display: grid;
    gap: var(--gap);
    max-width: 60rem;
    margin: 0 auto;
  }

  @media (min-width: 34rem) {
    .tiers { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 52rem) {
    .tiers { grid-template-columns: repeat(3, 1fr); }
  }

  .tier {
    position: relative;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
  }

  .tier--featured { border-color: var(--petrol); box-shadow: 0 8px 30px oklch(0.45 0.09 200 / 0.12); }

  .tier__badge {
    position: absolute;
    top: -0.75rem;
    right: 1.5rem;
    background: var(--amber);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius);
  }

  .tier__name { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; }
  .tier__subtitle { color: var(--muted); margin-bottom: 1rem; }
  .tier__price { color: var(--muted); margin-bottom: 1.25rem; }
  .tier__num { font-family: var(--font-display); font-size: 2.4rem; font-weight: 600; color: var(--ink); }

  .tier__features { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.55rem; }
  .tier__features li { color: var(--ink); }
  .tier__features span { color: var(--petrol); font-weight: 600; margin-right: 0.4rem; }

  .tier__cta { width: 100%; justify-content: center; }

  .subjects-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .subject-chip {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.5rem 0.9rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.92rem;
    background: var(--white);
  }

  .subject-chip:hover { border-color: var(--petrol); color: var(--petrol); }

  /* Why grid */
  .why-grid { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }
  @media (min-width: 46rem) { .why-grid { grid-template-columns: repeat(4, 1fr); } }
  .why-item h3 { color: var(--petrol); margin-bottom: 0.35rem; font-size: 1.15rem; }
  .why-item p { margin: 0; color: var(--muted); font-size: 0.96rem; }

  /* Resources */
  .posts-grid { display: grid; gap: var(--gap); }
  @media (min-width: 46rem) { .posts-grid { grid-template-columns: repeat(3, 1fr); } }

  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .post-card:hover { box-shadow: 0 10px 26px rgba(30, 34, 45, 0.1); transform: translateY(-2px); }
  .post-card__photo { border-radius: 0; }
  .post-card__body { padding: 1.25rem; display: flex; flex-direction: column; flex-grow: 1; }
  .post-card__body h3 { margin-bottom: 0.5rem; }
  .post-card__body p { color: var(--muted); flex-grow: 1; }
  .post-card__cta { color: var(--petrol); font-weight: 500; }

  .faq-wrap { max-width: 48rem; }

  /* Contact CTA */
  .cta { text-align: center; max-width: 40rem; margin: 0 auto; }
  .cta p { color: var(--stone); margin: 0 auto 1.75rem; max-width: 34rem; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: center; }
  .cta .btn--ghost { color: var(--stone); border-color: var(--stone); }
  .cta .btn--ghost:hover { background: var(--stone); color: var(--petrol); border-color: var(--stone); }
</style>
