---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="Resources | Yong's Tutoring"
  description="Study guides and revision resources for GCSE and A-level maths, economics, biology and chemistry from Yong's Tutoring, coming soon."
  path="/resources/"
>
  <section class="section">
    <div class="wrap resources">
      <p class="eyebrow">Resources</p>
      <h1>Study resources</h1>
      <p class="lede muted">
        We are putting together study guides and revision resources for GCSE and
        A-level maths, economics, biology and chemistry. This section is coming
        soon.
      </p>
      <div class="resources-soon">
        <span class="resources-soon__tag">Coming soon</span>
        <p>
          In the meantime, the best way to get help is a lesson. We will build a
          revision and past paper plan around your exam.
        </p>
        <a class="btn btn--primary" href={withBase('/contact/')}>Book a lesson</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resources { max-width: 44rem; }

  .resources-soon {
    margin-top: 2rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--stone-bg);
    padding: 2rem;
  }

  .resources-soon__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--petrol);
    border: 1px solid var(--petrol);
    border-radius: var(--radius);
    padding: 0.25rem 0.6rem;
    margin-bottom: 1rem;
  }

  .resources-soon p {
    color: var(--muted);
    max-width: 34rem;
  }
</style>
